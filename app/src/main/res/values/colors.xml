<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 动态颜色：引用 Material 3 主题角色色，随明暗模式 / 系统动态取色（Android 12+）自动变化 -->
    <color name="primary">?attr/colorPrimary</color>
    <color name="primary_dark">?attr/colorPrimary</color>
    <color name="accent">?attr/colorSecondary</color>
    <color name="background">?attr/colorSurfaceContainerLow</color>
    <color name="card_bg">?attr/colorSurfaceContainerLowest</color>
    <color name="text_primary">?attr/colorOnSurface</color>
    <color name="text_sub">?attr/colorOnSurfaceVariant</color>
    <!-- 图标圆形背景（主色容器色） -->
    <color name="icon_bg">?attr/colorPrimaryContainer</color>
    <!-- 启动图标背景：固定品牌色（自适应图标由系统无主题解析，不能引用 attr） -->
    <color name="ic_launcher_background">#1A73E8</color>

    <!-- 品牌固定色（主题亮/暗模式的兜底色，不被 attr 引用） -->
    <color name="brand_primary">#1A73E8</color>
    <color name="brand_accent">#1E8E5A</color>
    <color name="brand_primary_dark">#4A7BE0</color>
</resources>
