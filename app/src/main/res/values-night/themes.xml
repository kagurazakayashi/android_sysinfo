<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Components (Material 3) 暗色主题 -->
    <style name="AppTheme" parent="Theme.Material3.DynamicColors.Dark.NoActionBar">
        <!-- 暗色品牌色：稍深蓝保证白字对比度 -->
        <item name="colorPrimary">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">#16336E</item>
        <item name="colorOnPrimaryContainer">#D7E2FF</item>
        <item name="colorSecondary">#7ED3A1</item>
        <item name="colorOnSecondary">#0A3D24</item>
        <item name="colorSecondaryContainer">#1E4D38</item>
        <item name="colorOnSecondaryContainer">#D3F2E2</item>
        <!-- 表面色：暗色背景 -->
        <item name="colorSurfaceContainerLow">#1E1E22</item>
        <item name="colorSurfaceContainerLowest">#141417</item>
        <!-- 状态栏：与顶栏同色 -->
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <!-- Material 组件默认样式（复用亮色定义，颜色为 attr 引用自动适配） -->
        <item name="materialAlertDialogTheme">@style/AppDialog</item>
        <item name="materialCardViewStyle">@style/AppCard</item>
    </style>
</resources>
